--- a/bringup/init
+++ b/bringup/init
@@ -10,11 +10,17 @@
 mkdir -p /proc /sys /dev /run /tmp /root /dev/pts /sys/kernel/config
 mount -t proc proc /proc
 mount -t sysfs sysfs /sys
-mount -t tmpfs -o mode=0755 tmpfs /dev
-mknod /dev/null c 1 3
-mknod /dev/zero c 1 5
-mknod /dev/console c 5 1
-mknod /dev/kmsg c 1 11
+# The tier-1 kernel has devtmpfs (systemd needs it); the stock kernel does not.
+# DEVTMPFS_MOUNT does not apply to an initramfs boot, so mount it here.
+if grep -qw devtmpfs /proc/filesystems; then
+    mount -t devtmpfs -o mode=0755,nosuid devtmpfs /dev
+else
+    mount -t tmpfs -o mode=0755 tmpfs /dev
+fi
+[ -e /dev/null ] || mknod /dev/null c 1 3
+[ -e /dev/zero ] || mknod /dev/zero c 1 5
+[ -e /dev/console ] || mknod /dev/console c 5 1
+[ -e /dev/kmsg ] || mknod /dev/kmsg c 1 11
 exec >/dev/kmsg 2>&1
 echo 'VEGAS_NATIVE_LINUX_INIT_STARTED'
 mount -t tmpfs tmpfs /run
@@ -127,6 +133,36 @@
         cp /www/cgi-bin/card-report /www/cgi-bin/hardware-report /newroot/usr/local/libexec/vegas/www/cgi-bin/
         cp /run/modules.log /newroot/var/log/vegas-modules.log
         echo "$source $reason" >/run/vegas-boot-source
+        # PID 1: systemd only with devtmpfs, the root's systemd units installed
+        # (vegas-systemd-setup) and a request (vegas-init). Any systemd boot that
+        # the root does not confirm (desktop + recovery httpd up for 60 s) leaves
+        # systemd-pending behind, and the next boot is native-init again.
+        init=/usr/local/libexec/vegas/native-init
+        v=/newroot/etc/vegas
+        pending=/newroot/var/lib/vegas/systemd-pending
+        if grep -qw devtmpfs /proc/filesystems && [ -x /newroot/usr/lib/systemd/systemd ] &&
+           [ -f /newroot/var/lib/vegas/systemd-setup/installed ]; then
+            if [ -n "$card_ok" ] && [ -e /mnt/arch/force-native-init ]; then
+                echo 'VEGAS_INIT_REASON:force-native-init on the card'
+            elif [ -e "$pending" ]; then
+                [ -f "$v/systemd" ] && mv -f "$v/systemd" "$v/systemd.disabled-unstable"
+                rm -f "$v/systemd-once" "$pending"
+                echo 'VEGAS_INIT_REASON:last systemd boot unconfirmed'
+            elif [ -f "$v/systemd-once" ] && [ ! -L "$v/systemd-once" ]; then
+                rm -f "$v/systemd-once"
+                init=/usr/lib/systemd/systemd
+            elif [ -f "$v/systemd" ] && [ ! -L "$v/systemd" ]; then
+                init=/usr/lib/systemd/systemd
+            fi
+        fi
+        if [ "$init" = /usr/lib/systemd/systemd ]; then
+            mkdir -p /newroot/var/lib/vegas
+            : >"$pending"
+            # systemd expects a 0755 /run (it does not remount one it finds).
+            chmod 0755 /run
+        fi
+        echo "VEGAS_INIT:$init"
+        echo "$init" >/run/vegas-init
         # This static process needs no old-root files after switch_root.
         /bin/desktop-watchdog &
         echo "$!" >/run/desktop-watchdog.pid
@@ -138,7 +174,7 @@
         done
         umount /mnt/arch 2>/dev/null
         umount /mnt/ufs 2>/dev/null
-        exec /bin/busybox switch_root /newroot /usr/local/libexec/vegas/native-init
+        exec /bin/busybox switch_root /newroot "$init"
     else
         echo 'Verified desktop root unavailable; retaining USB diagnostics'
     fi
