 #if PAN_BASE_API < 2
+/* Oldest submit sequence still executing, or UINT64_MAX when idle.
+ * Caller holds handle_lock. */
+static uint64_t
+kbase_jm_oldest_inflight(kbase k)
+{
+        uint64_t oldest = UINT64_MAX;
+
+        for (unsigned i = 0; i < ARRAY_SIZE(k->atom_bos); ++i)
+                if (k->atom_bos[i].data)
+                        oldest = MIN2(oldest, k->jm_atom_seq[i]);
+
+        return oldest;
+}
+
+/* Run deferred BO frees whose jobs have all completed. Callbacks run with no
+ * kbase lock held, since they take Panfrost's BO locks. */
+static void
+kbase_jm_run_deferred(kbase k)
+{
+        struct kbase_sync_link *ready = NULL;
+
+        pthread_mutex_lock(&k->queue_lock);
+        pthread_mutex_lock(&k->handle_lock);
+        uint64_t oldest = kbase_jm_oldest_inflight(k);
+        pthread_mutex_unlock(&k->handle_lock);
+
+        struct kbase_sync_link **p = &k->jm_deferred;
+        while (*p) {
+                struct kbase_sync_link *link = *p;
+                if (link->seqnum <= oldest) {
+                        *p = link->next;
+                        link->next = ready;
+                        ready = link;
+                } else {
+                        p = &link->next;
+                }
+        }
+        pthread_mutex_unlock(&k->queue_lock);
+
+        while (ready) {
+                struct kbase_sync_link *next = ready->next;
+                ready->callback(ready->data);
+                free(ready);
+                ready = next;
+        }
+}
