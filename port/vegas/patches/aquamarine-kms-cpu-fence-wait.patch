@@ -45,6 +48,55 @@ using namespace Hyprutils::Memory;
 using namespace Hyprutils::Math;
 #define SP CSharedPointer
 
+// Some KMS stacks (e.g. the MediaTek mediatek_v2 vendor driver with ARM's
+// mali_kbase) have neither implicit dma-buf fencing nor a KMS driver that waits
+// on a plane's IN_FENCE_FD, so a freshly rendered buffer can be scanned out
+// before the GPU has finished writing it. With AQ_KMS_CPU_FENCE_WAIT=1, block
+// (bounded) on the consumer's render fence before the buffer is handed to KMS.
+static constexpr int KMS_CPU_FENCE_WAIT_TIMEOUT_MS = 100;
+
+static void cpuWaitForInFence(SP<CBackend> backend, const std::string& outputName, int fenceFD) {
+    static uint64_t frames = 0, blocked = 0, timeouts = 0, totalWaitUs = 0, maxWaitUs = 0;
+
+    pollfd     pfd     = {.fd = fenceFD, .events = POLLIN, .revents = 0};
+    const auto started = std::chrono::steady_clock::now();
+    int        ret     = poll(&pfd, 1, 0);
+
+    if (ret == 0) {
+        ++blocked;
+        const auto deadline = started + std::chrono::milliseconds(KMS_CPU_FENCE_WAIT_TIMEOUT_MS);
+        while (true) {
+            const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now()).count();
+            if (left <= 0) {
+                ret = 0;
+                break;
+            }
+            ret = poll(&pfd, 1, (int)left + 1);
+            if (ret < 0 && errno == EINTR)
+                continue;
+            break;
+        }
+    }
+
+    const uint64_t waitedUs = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - started).count();
+    totalWaitUs += waitedUs;
+    maxWaitUs = std::max(maxWaitUs, waitedUs);
+    ++frames;
+
+    if (ret == 0) {
+        ++timeouts;
+        backend->log(AQ_LOG_WARNING, std::format("drm: render fence on {} not signalled after {} ms, committing anyway", outputName, KMS_CPU_FENCE_WAIT_TIMEOUT_MS));
+    } else if (ret < 0)
+        backend->log(AQ_LOG_WARNING, std::format("drm: poll on render fence for {} failed: {}", outputName, strerror(errno)));
+
+    if (frames % 600 == 0) {
+        backend->log(AQ_LOG_DEBUG,
+                     std::format("drm: KMS CPU fence wait: {} frames, render unfinished at commit in {}, avg wait {} us, max {} us, timeouts {}", frames, blocked,
+                                 totalWaitUs / frames, maxWaitUs, timeouts));
+        maxWaitUs = 0;
+    }
+}
