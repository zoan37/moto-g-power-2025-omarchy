+        if (!NEXT)
+            continue;
+
+        const auto RESULT = OutputTiming::toSteadyClock(*NEXT, MONOTONIC_NOW, STEADY_BEFORE, STEADY_AFTER);
+        if (RESULT)
+            return RESULT;
+    }
+
+    return std::nullopt;
