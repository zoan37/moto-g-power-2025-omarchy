diff --git i/src/panfrost/base/pan_base.c w/src/panfrost/base/pan_base.c
index 22dc09c..d3870b9 100644
--- i/src/panfrost/base/pan_base.c
+++ w/src/panfrost/base/pan_base.c
@@ -53,17 +53,24 @@ kbase_open(kbase k, int fd, unsigned cs_queue_count, bool verbose)
         if (k->fd == -1)
            return kbase_open_csf_noop(k);
 
+        const bool trace = getenv("VEGAS_GPU_TRACE") != NULL;
         struct kbase_ioctl_version_check ver = { 0 };
 
         if (ioctl(k->fd, KBASE_IOCTL_VERSION_CHECK_RESERVED, &ver) == 0) {
+                if (trace)
+                        fprintf(stderr, "[vegas-gpu] Kbase CSF API %u.%u\n", ver.major, ver.minor);
                 return kbase_open_csf(k);
         } else if (ioctl(k->fd, KBASE_IOCTL_VERSION_CHECK, &ver) == 0) {
+                if (trace)
+                        fprintf(stderr, "[vegas-gpu] Kbase JM API %u.%u\n", ver.major, ver.minor);
                 if (ver.major == 3)
                         return kbase_open_old(k);
                 else
                         return kbase_open_new(k);
         }
 
+        if (trace)
+                fprintf(stderr, "[vegas-gpu] Kbase version check failed: %s\n", strerror(errno));
         return false;
 }
 
diff --git i/src/panfrost/base/pan_vX_base.c w/src/panfrost/base/pan_vX_base.c
