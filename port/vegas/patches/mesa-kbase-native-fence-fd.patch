diff --git i/src/panfrost/base/pan_vX_base.c w/src/panfrost/base/pan_vX_base.c
index 4c9c273..09fff85 100644
--- i/src/panfrost/base/pan_vX_base.c
+++ w/src/panfrost/base/pan_vX_base.c
@@ -1178,6 +1230,140 @@ kbase_wait_jm_atoms_idle(kbase k)
         return false;
 }
 
+#if PAN_BASE_API == 1
+/* Submit a software atom (a dependency-only merge or a fence trigger) ordered
+ * after up to two atoms (0 means none). Caller holds jm_submit_lock and has
+ * reserved enough atom numbers that no ID wrap happens here. The atom holds no
+ * BOs; a -1 placeholder handle keeps it visible to the in-flight checks
+ * (atom_bos[].data != NULL) until the kernel reports it done, and the event
+ * handler skips the placeholder. Returns the atom number or -1. */
+static int
+kbase_jm_submit_soft(kbase k, base_jd_core_req req, uint64_t jc,
+                     unsigned dep0, unsigned dep1)
+{
+        struct util_dynarray buf;
+        util_dynarray_init(&buf, NULL);
+        util_dynarray_append(&buf, int32_t, -1);
+
+        pthread_mutex_lock(&k->handle_lock);
+        uint8_t nr = k->atom_number++;
+        struct base_jd_atom_v2 atom = {
+                .jc = jc,
+                .atom_number = nr,
+                .core_req = req,
+                .udata.blob[0] = k->job_seq++,
+        };
+        assert(!k->atom_bos[nr].data);
+        k->atom_bos[nr] = buf;
+        k->jm_atom_seq[nr] = atom.udata.blob[0];
+        pthread_mutex_unlock(&k->handle_lock);
+
+        if (dep0) {
+                atom.pre_dep[0].atom_id = dep0;
+                atom.pre_dep[0].dependency_type = BASE_JD_DEP_TYPE_ORDER;
+        }
+        if (dep1) {
+                atom.pre_dep[1].atom_id = dep1;
+                atom.pre_dep[1].dependency_type = BASE_JD_DEP_TYPE_ORDER;
+        }
+
+#if PAN_BASE_API == 1
+        /* Same MediaTek r38p1 v2-prefix submission as kbase_submit. */
+        struct {
+                struct base_jd_atom_v2 atom;
+                uint64_t vendor_tail;
+        } wire = { .atom = atom };
+        struct kbase_ioctl_job_submit submit = {
+                .nr_atoms = 1,
+                .stride = offsetof(struct base_jd_atom_v2, renderpass_id),
+                .addr = (uintptr_t) &wire,
+        };
+#else
+        struct kbase_ioctl_job_submit submit = {
+                .nr_atoms = 1,
+                .stride = sizeof(atom),
+                .addr = (uintptr_t) &atom,
+        };
+#endif
+        if (kbase_ioctl(k->fd, KBASE_IOCTL_JOB_SUBMIT, &submit) == -1) {
+                perror("ioctl(KBASE_IOCTL_JOB_SUBMIT) soft atom");
+                pthread_mutex_lock(&k->handle_lock);
+                util_dynarray_fini(&k->atom_bos[nr]);
+                pthread_mutex_unlock(&k->handle_lock);
+                return -1;
+        }
+
+        return nr;
+}
+
+/* EGL_ANDROID_native_fence_sync on JM: merge the syncobj's outstanding atoms
+ * pairwise with BASE_JD_REQ_DEP atoms (an atom has only two pre-deps), then
+ * submit a BASE_JD_REQ_SOFT_FENCE_TRIGGER atom after them. The kernel creates
+ * a sync_file for the trigger, writes its fd into the base_fence at jc during
+ * the submit ioctl, and signals it when the trigger atom runs. */
+static int
+kbase_syncobj_export_fd(kbase k, struct kbase_syncobj *o)
+{
+        unsigned pending[255];
+        unsigned n = 0;
+
+        pthread_mutex_lock(&k->jm_submit_lock);
+
+        pthread_mutex_lock(&k->queue_lock);
+        kbase_syncobj_update(k, o);
+        list_for_each_entry(struct kbase_fence, fence, &o->fences, link) {
+                if (n < ARRAY_SIZE(pending))
+                        pending[n++] = fence->slot;
+        }
+        pthread_mutex_unlock(&k->queue_lock);
+
+        /* The merge tree plus the trigger needs at most n atom numbers. If they
+         * would cross the eight-bit wrap, drain first: every pending atom is
+         * then complete, so the fence has no dependencies left. */
+        if (k->atom_number == 0 || (unsigned) k->atom_number + n + 1 > 255) {
+                if (k->job_seq != 0 && !kbase_wait_jm_atoms_idle(k)) {
+                        pthread_mutex_unlock(&k->jm_submit_lock);
+                        return -1;
+                }
+                k->atom_number = 1;
+                n = 0;
+        }
+
+        while (n > 2) {
+                unsigned merged = 0;
+                for (unsigned i = 0; i < n; i += 2) {
+                        if (i + 1 == n) {
+                                pending[merged++] = pending[i];
+                                break;
+                        }
+                        int dep = kbase_jm_submit_soft(k, BASE_JD_REQ_DEP, 0,
+                                                       pending[i], pending[i + 1]);
+                        if (dep < 0) {
+                                pthread_mutex_unlock(&k->jm_submit_lock);
+                                return -1;
+                        }
+                        pending[merged++] = dep;
+                }
+                n = merged;
+        }
+
+        struct base_fence fence = { .basep = { .fd = -1, .stream_fd = -1 } };
+        int nr = kbase_jm_submit_soft(k, BASE_JD_REQ_SOFT_FENCE_TRIGGER,
+                                      (uintptr_t) &fence,
+                                      n > 0 ? pending[0] : 0,
+                                      n > 1 ? pending[1] : 0);
+
+        pthread_mutex_unlock(&k->jm_submit_lock);
+
+        if (getenv("VEGAS_GPU_TRACE"))
+                fprintf(stderr, "[vegas-gpu] fence export atom=%d deps=%u fd=%d\n",
+                        nr, n, fence.basep.fd);
+
+        return nr < 0 ? -1 : fence.basep.fd;
+}
