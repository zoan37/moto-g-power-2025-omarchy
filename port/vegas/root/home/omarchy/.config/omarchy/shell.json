{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 600
  },
  "bar": {
    "id": "vegas.bar",
    "phoneSafeTop": 0,
    "phoneBarHeight": 28,
    "phoneSideInset": 0,
    "position": "top",
    "transparent": false,
    "centerAnchor": "",
    "layout": {
      "left": [
        {
          "id": "omarchy.spacer",
          "size": 12
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm"
        }
      ],
      "center": [],
      "right": [
        {
          "id": "vegas.bootsource"
        },
        {
          "id": "vegas.wifi"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        },
        {
          "id": "omarchy.spacer",
          "size": 12
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "vegas.mobile",
      "navHeight": 44,
      "home": true,
      "gestures": true,
      "pinned": [
        {
          "name": "Terminal",
          "glyph": "\uf120",
          "exec": "foot",
          "match": "^foot$"
        },
        {
          "name": "Grok",
          "icon": "~/.local/share/icons/hicolor/256x256/apps/grok.png",
          "exec": "/usr/local/bin/omarchy-launch-webapp https://grok.com",
          "match": "^chrome-grok\\.com"
        },
        {
          "name": "X",
          "icon": "~/.local/share/applications/icons/X.png",
          "exec": "/usr/local/bin/omarchy-launch-webapp https://x.com/",
          "match": "^chrome-x\\.com"
        },
        {
          "name": "Apps",
          "glyph": "\uf00a",
          "action": "apps"
        },
        {
          "name": "Omarchy",
          "glyph": "\ue900",
          "font": "omarchy",
          "action": "menu"
        }
      ]
    },
    {
      "id": "vegas.quick"
    }
  ]
}
