# No systemd-logind on the native boot, so brightnessctl cannot ask it to set
# brightness; let the video group (the desktop user) write the backlight directly.
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/usr/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/usr/bin/chmod g+w /sys/class/backlight/%k/brightness"
