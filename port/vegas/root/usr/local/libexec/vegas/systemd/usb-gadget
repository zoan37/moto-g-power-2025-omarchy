#!/bin/bash
# systemd boot: make sure the USB recovery link exists (vegas-usb-gadget.service).
# The ramdisk (bringup/init) creates this gadget (ACM serial + ECM network), binds
# it and puts 192.168.77.1/30 on usb0 before switch_root. configfs and the netdev
# survive switch_root, so normally this only re-applies the address (as native-init
# did). It rebuilds the same gadget only when a ramdisk did not.
set -u
helper=/usr/local/libexec/vegas
cfg=/sys/kernel/config
g=$cfg/usb_gadget/vegas_linux
udc=11201000.usb0
mountpoint -q "$cfg" || mount -t configfs configfs "$cfg"
if [[ ! -d $g/configs/c.1 ]]; then
  echo 'USB gadget missing; creating it as the ramdisk does'
  mkdir -p "$g"
  echo 0x1d6b >"$g/idVendor"
  echo 0x0104 >"$g/idProduct"
  echo 0x0200 >"$g/bcdUSB"
  mkdir -p "$g/strings/0x409"
  echo vegas-linux-dev >"$g/strings/0x409/serialnumber"
  echo 'Linux development' >"$g/strings/0x409/manufacturer"
  echo 'Vegas native Linux diagnostic' >"$g/strings/0x409/product"
  mkdir -p "$g/configs/c.1/strings/0x409"
  echo 'USB shell and network' >"$g/configs/c.1/strings/0x409/configuration"
  echo 100 >"$g/configs/c.1/MaxPower"
  mkdir -p "$g/functions/acm.usb0" "$g/functions/ecm.usb0"
  [[ -e $g/configs/c.1/acm.usb0 ]] || ln -s "$g/functions/acm.usb0" "$g/configs/c.1/"
  echo 02:00:00:00:77:01 >"$g/functions/ecm.usb0/dev_addr"
  echo 02:00:00:00:77:02 >"$g/functions/ecm.usb0/host_addr"
  [[ -e $g/configs/c.1/ecm.usb0 ]] || ln -s "$g/functions/ecm.usb0" "$g/configs/c.1/"
fi
if [[ -z $(cat "$g/UDC" 2>/dev/null) ]]; then
  echo "$udc" >"$g/UDC" && echo 'USB gadget bound'
fi
for ((i=0; i<100; i++)); do
  [[ -e /sys/class/net/usb0 ]] && break
  sleep 0.1
done
[[ -e /sys/class/net/usb0 ]] || { echo 'usb0 did not appear'; exit 1; }
if command -v ip >/dev/null; then
  ip addr replace 192.168.77.1/30 dev usb0 && ip link set usb0 up
else
  "$helper/busybox" ifconfig usb0 192.168.77.1 netmask 255.255.255.252 up
fi
