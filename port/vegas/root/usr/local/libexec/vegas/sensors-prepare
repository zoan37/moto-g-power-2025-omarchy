#!/bin/bash
# Sensors (vegas-sensors.service): MediaTek's sensor hub runs the sensor drivers
# on the SCP coprocessor; hf_manager.ko + sensorhub.ko give Linux
# /dev/hf_manager (notes/sensors-20261011.md). The SCP chain is normally loaded
# by audio-prepare; load it here too when audio is disabled.
set -u
modules=/opt/vegas-sensors/modules
audio=/opt/vegas-audio/modules
[[ -e /var/lib/vegas/no-sensors ]] && { echo 'sensors disabled by no-sensors'; exit 0; }
for _ in $(seq 1 60); do [[ -d /sys/module/scp ]] && break; sleep 1; done
for m in adsp mtk-afe-external scp; do
  [[ -d /sys/module/${m//-/_} ]] || timeout -k 2 20 insmod "$audio/$m.ko" || { echo "insmod $m failed"; exit 1; }
done
for m in hf_manager sensorhub; do
  [[ -d /sys/module/$m ]] || timeout -k 2 20 insmod "$modules/$m.ko" || { echo "insmod $m failed"; exit 1; }
done
for _ in $(seq 1 20); do [[ -c /dev/hf_manager ]] && break; sleep 0.5; done
[[ -c /dev/hf_manager ]] || { echo 'no /dev/hf_manager'; exit 1; }
echo 'sensor hub ready'
