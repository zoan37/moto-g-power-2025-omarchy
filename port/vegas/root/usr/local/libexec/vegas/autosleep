#!/bin/bash
# Android-style autosleep (vegas-autosleep.service, root). While the desktop's
# screen is off (vegas-power-key keeps $request in place), suspend to s2idle,
# the only mem_sleep state this kernel has, as on Android. Any wake that isn't
# the power key (charger alarm, battery gauge, RTC) finds the screen still off
# and goes back to sleep after a short grace period; a power key press makes
# vegas-power-key switch the screen on and remove $request.
#
# Stays awake while:
#   - /var/lib/vegas/no-suspend exists (opt out)
#   - USB data is connected (the gadget is configured: the laptop's recovery
#     endpoint and development; a plain charger still lets it sleep)
#   - a sound card PCM is running (music with the screen off)
#   - vegas-power-key isn't running (nothing could turn the screen back on)
#
# Sync windows, like Android Doze's maintenance windows: while asleep the RTC
# wakes the phone every $sync_min minutes and it stays up $sync_s seconds, so
# Chrome's push connection can reconnect and deliver queued notifications.
# Wi-Fi power save is on while the screen is off.
#
# Wake on Wi-Fi (default; opt out with /var/lib/vegas/no-wake-on-wifi): the
# firmware's WoWLAN "any" trigger wakes the phone for incoming packets, so a
# push message (Chrome's GCM connection) arrives at once, as on Android. The
# firmware can't filter broadcasts (ARP/mDNS also wake it; nl80211 offers only
# any/disconnect/magic-packet here), so after a Wi-Fi wake the phone stays up
# only while real traffic keeps arriving: 1 s, extended while wlan0 receives
# more than $traffic_bytes per second (up to $traffic_max s).
# Log: /var/log/vegas/autosleep.log (one line per sleep, with the wake reason).
set -u
request=/run/user/1000/vegas-screen-off
delay=${VEGAS_SLEEP_DELAY:-5}      # seconds of screen-off before the first sleep
grace=${VEGAS_SLEEP_GRACE:-2}      # seconds awake after a wake that isn't the power key
sync_min=${VEGAS_SLEEP_SYNC_MIN:-15}
sync_s=${VEGAS_SLEEP_SYNC_S:-30}
rtc=/sys/class/rtc/rtc0/wakealarm
traffic_bytes=${VEGAS_SLEEP_TRAFFIC_BYTES:-1500}
traffic_max=${VEGAS_SLEEP_TRAFFIC_MAX:-15}
rx=/sys/class/net/wlan0/statistics/rx_bytes

log() { printf '%s %s\n' "$(date +%T)" "$*"; }

inhibitor() {
  [[ -e /var/lib/vegas/no-suspend ]] && { echo 'no-suspend file'; return; }
  local u
  # VEGAS_SLEEP_IGNORE_USB=1: for testing the sleep loop over the USB link.
  [[ ${VEGAS_SLEEP_IGNORE_USB:-0} == 1 ]] ||
  for u in /sys/class/udc/*/state; do
    [[ $(cat "$u" 2>/dev/null) == configured ]] && { echo 'USB data connected'; return; }
  done
  grep -qs RUNNING /proc/asound/card*/pcm*p/sub*/status && { echo 'audio playing'; return; }
  pgrep -f /usr/local/bin/vegas-power-key >/dev/null || { echo 'vegas-power-key not running'; return; }
}

# One suspend. MediaTek's checkers refuse now and then (an alarm timer due
# within 2 s, a clock still on): retry a few times like Android's autosleep.
sleep_once() {
  local try since
  since=$(date +%s)
  for try in 1 2 3 4 5; do
    [[ -e $request ]] || return 1
    if echo mem >/sys/power/state 2>/dev/null; then
      local wake
      wake=$(journalctl -k -o cat --no-pager -S "@$since" 2>/dev/null | sed -n 's/.*Resume caused by //p' | tail -1)
      woke=${wake:-unknown}
      log "slept $(( $(date +%s) - since ))s, woke: $woke, battery $(cat /sys/class/power_supply/battery/capacity)%"
      return 0
    fi
    sleep 1
  done
  log "suspend refused 5 times: $(head -1 /sys/power/suspend_stats/last_failed_dev) $(head -1 /sys/power/suspend_stats/last_failed_step)"
  return 1
}

wifi_power_save() { iw dev wlan0 set power_save "$1" 2>/dev/null; }
wake_on_wifi() {
  if [[ -e /var/lib/vegas/no-wake-on-wifi ]]; then iw phy phy0 wowlan disable 2>/dev/null
  else iw phy phy0 wowlan enable any 2>/dev/null; fi
}

# After a Wi-Fi wake: 1 s, then as long as real traffic keeps arriving.
traffic_grace() {
  local i before after
  for (( i = 0; i < traffic_max; i++ )); do
    before=$(cat "$rx" 2>/dev/null || echo 0)
    sleep 1
    after=$(cat "$rx" 2>/dev/null || echo 0)
    (( after - before > traffic_bytes )) || break
    [[ -e $request ]] || return
  done
  (( i > 0 )) && log "stayed up ${i}s for network traffic"
}

# A sync window: awake for $sync_s seconds unless the screen comes back on.
sync_window() {
  log "sync window ${sync_s}s"
  local i
  for (( i = 0; i < sync_s; i++ )); do
    [[ -e $request ]] || return
    sleep 1
  done
}

last_reason='' next_sync=0 sleeping=0
while sleep 1; do
  if [[ ! -e $request ]]; then
    if (( sleeping )); then
      echo 0 >"$rtc" 2>/dev/null
      wifi_power_save off
      sleeping=0 next_sync=0
    fi
    last_reason=''
    continue
  fi
  (( $(date +%s) - $(stat -c %Y "$request" 2>/dev/null || date +%s) >= delay )) || continue
  reason=$(inhibitor)
  if [[ -n $reason ]]; then
    [[ $reason != "$last_reason" ]] && log "screen off, staying awake: $reason"
    last_reason=$reason
    continue
  fi
  last_reason=''
  if (( ! sleeping )); then
    sleeping=1
    wifi_power_save on
    wake_on_wifi
  fi
  (( next_sync )) || next_sync=$(( $(date +%s) + sync_min * 60 ))
  if (( sync_min > 0 )); then
    echo 0 >"$rtc" 2>/dev/null; echo "$next_sync" >"$rtc" 2>/dev/null
  fi
  woke=''
  sleep_once || { sleep 5; continue; }
  if [[ $woke == *wlan* ]]; then
    traffic_grace
  else
    # The power key, if that's what woke us, reaches vegas-power-key now.
    sleep "$grace"
  fi
  if (( sync_min > 0 && $(date +%s) >= next_sync - 2 )); then
    sync_window
    next_sync=$(( $(date +%s) + sync_min * 60 ))
  fi
done
