#!/bin/bash
# Charge limit ("battery protect"), like Motorola's on Android: stop charging the
# battery at a set percentage while USB keeps powering the phone, resume 5
# points below. Uses Motorola's adaptive-charging switch in the MediaTek charger
# driver: a non-zero write to mtk-master-charger/current_max sets
# adaptive_charging_disable_ibat (charging off, power path on), 0 clears it.
# Tested: battery current 600 mA -> 0 with USB online, and back.
#
#   vegas-charge-limit 50..95   set the limit (persistent)
#   vegas-charge-limit off      charge to 100% (default)
#   vegas-charge-limit status
#   vegas-charge-limit run      the service loop (vegas-charge-limit.service)
set -u
setting=/var/lib/vegas/charge-limit
switch=/sys/class/power_supply/mtk-master-charger/current_max
b=/sys/class/power_supply/battery
limit() { local v; v=$(cat "$setting" 2>/dev/null); [[ $v =~ ^[0-9]+$ ]] && (( v >= 50 && v <= 95 )) && echo "$v"; }
charge() { echo "$1" >"$switch"; }      # 1 = charging off, 0 = normal

case ${1:-status} in
  off) rm -f "$setting"; charge 0; echo 'charge limit off' ;;
  [0-9]*)
    (( $1 >= 50 && $1 <= 95 )) || { echo 'limit must be 50..95' >&2; exit 2; }
    mkdir -p "$(dirname "$setting")"; echo "$1" >"$setting"; echo "charge limit $1%" ;;
  status)
    l=$(limit); echo "limit: ${l:-off}; battery $(cat $b/capacity)% $(cat $b/status), current $(cat $b/current_now) mA"
    journalctl -k -b -g 'adaptive charging' -q --no-pager -n 1 2>/dev/null | sed 's/.*adaptive charging:/driver:/' | cut -c1-80 ;;
  run)
    trap 'charge 0; exit 0' TERM INT EXIT
    held=0
    while true; do
      l=$(limit) cap=$(cat "$b/capacity" 2>/dev/null || echo -1)
      if [[ -z $l || $cap -lt 0 ]]; then
        (( held )) && { charge 0; held=0; echo "$(date +%T) limit off: charging"; }
      elif (( ! held && cap >= l )); then
        charge 1; held=1; echo "$(date +%T) battery $cap% >= $l%: charging paused"
      elif (( held && cap <= l - 5 )); then
        charge 0; held=0; echo "$(date +%T) battery $cap% <= $((l - 5))%: charging"
      fi
      sleep 60 & wait $!
    done ;;
  *) echo 'usage: vegas-charge-limit 50..95|off|status|run' >&2; exit 2 ;;
esac
