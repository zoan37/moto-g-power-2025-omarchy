#!/bin/bash
# Phone UI scale for the next desktop start, stored where Omarchy's Display
# panel keeps it. The 1080x2388 panel divides evenly at these scales
# (logical width 720, 540, 450, 360).
lua="$HOME/.config/hypr/monitors.lua"
current() { sed -n 's/^local omarchy_monitor_scale = \([0-9.]*\)$/\1/p' "$lua"; }
case ${1:-status} in
  1.5|2|2.4|3)
    sed -i -E "s|^local omarchy_monitor_scale = .*|local omarchy_monitor_scale = $1|" "$lua"
    printf 'Scale %s selected; reboot to apply.\n' "$1" ;;
  status) printf 'Scale: %s\n' "$(current)" ;;
  *) printf 'Usage: vegas-scale 1.5|2|2.4|3|status\n' >&2; exit 2 ;;
esac
