#!/usr/bin/env python3
"""Power key like a phone: a short press turns the screen off (or back on), a
long press opens the power menu (Omarchy's system menu), as on Android.

Hyprland's own XF86PowerOff binding (Omarchy: system menu on every press) and
its key/mouse-wakes-the-screen options are off on the phone (hyprland.lua), so
this daemon alone decides when the panel is on. With the panel off, the TDDI
touch controller is reset with it, so stray touches don't reach apps. A key
from the panel's "double-tap" gesture device wakes the screen too. While the
screen is off, $XDG_RUNTIME_DIR/vegas-screen-off lets the root autosleep
service suspend the phone; the power key wakes it (wakeup-source in the DT).

Screen timeout, as on Android: after ~/.config/vegas/screen-timeout seconds
(default 60, 0 = never) without a touch or key, the screen turns off. It stays
on while audio plays (video) and while USB data is connected (Android's "stay
awake while charging" developer option; keeps the laptop's screenshots working).
Runs in the desktop session (autostart.lua).
"""
import fcntl
import glob
import json
import os
import select
import struct
import subprocess
import sys
import time

EV_KEY = 1
KEY_POWER = 116
LONG_PRESS_S = 0.6
TIMEOUT_FILE = os.path.expanduser('~/.config/vegas/screen-timeout')
DEFAULT_TIMEOUT_S = 60
EVENT = struct.Struct('llHHi')        # struct input_event on aarch64


def log(*args):
    print(time.strftime('%H:%M:%S'), *args, flush=True)


def open_device(wanted):
    for path in sorted(glob.glob('/dev/input/event*')):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        name = fcntl.ioctl(fd, (2 << 30) | (128 << 16) | (ord('E') << 8) | 0x06, bytes(128))
        if name.split(b'\0')[0] == wanted:
            return fd
        os.close(fd)
    return None


def hyprctl(*args):
    return subprocess.run(['hyprctl', *args], capture_output=True, text=True).stdout


def screen_on():
    try:
        return all(m.get('dpmsStatus', True) for m in json.loads(hyprctl('-j', 'monitors')))
    except ValueError:
        return True


# While this file exists the root autosleep service suspends the phone
# (/usr/local/libexec/vegas/autosleep); its mtime is when the screen went off.
SCREEN_OFF = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/run/user/1000'), 'vegas-screen-off')


def set_screen(on):
    if on:
        try:
            os.unlink(SCREEN_OFF)
        except FileNotFoundError:
            pass
    hyprctl('dispatch', 'hl.dsp.dpms({ action = "%s" })' % ('enable' if on else 'disable'))
    if not on:
        with open(SCREEN_OFF, 'w'):
            pass
    log('screen', 'on' if on else 'off')


def screen_timeout():
    try:
        with open(TIMEOUT_FILE) as f:
            return max(0, int(f.read().strip()))
    except (OSError, ValueError):
        return DEFAULT_TIMEOUT_S


def keep_awake():
    # VEGAS_TIMEOUT_IGNORE_USB=1: for testing the timeout over the USB link.
    usb = [] if os.environ.get('VEGAS_TIMEOUT_IGNORE_USB') == '1' else glob.glob('/sys/class/udc/*/state')
    for state in usb:
        try:
            with open(state) as f:
                if f.read().strip() == 'configured':
                    return 'USB data connected'
        except OSError:
            pass
    for status in glob.glob('/proc/asound/card*/pcm*p/sub*/status'):
        try:
            with open(status) as f:
                if 'RUNNING' in f.read():
                    return 'audio playing'
        except OSError:
            pass
    return ''


def power_menu():
    subprocess.Popen(['/usr/local/bin/vegas-vibrate', 'tick'])     # Android's long-press tick
    if not screen_on():
        set_screen(True)
    subprocess.Popen(['omarchy-menu', 'toggle', 'system'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    log('power menu')


def events(fd):
    try:
        data = os.read(fd, EVENT.size * 64)
    except BlockingIOError:
        return
    for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
        yield EVENT.unpack_from(data, i)[2:]


def main():
    power = open_device(b'mtk-pmic-keys')
    if power is None:
        sys.exit('mtk-pmic-keys not found')
    tap = open_device(b'double-tap')
    # Activity only (no grab): any touch or other key restarts the timeout.
    activity = [fd for fd in (open_device(b'ILITEK_TDDI'), open_device(b'mtk-kpd')) if fd is not None]
    fds = [power] + ([tap] if tap is not None else []) + activity
    last_input = time.monotonic()
    if screen_on() and os.path.exists(SCREEN_OFF):
        os.unlink(SCREEN_OFF)       # stale, from a previous session
    pressed_at = None        # monotonic time of the current power key press
    long_fired = False
    while True:
        timeout = 5.0                  # re-check the screen timeout this often
        if pressed_at is not None and not long_fired:
            timeout = max(0.0, pressed_at + LONG_PRESS_S - time.monotonic())
        ready, _, _ = select.select(fds, [], [], timeout)
        if ready:
            last_input = time.monotonic()
        idle_limit = screen_timeout()
        if (idle_limit and pressed_at is None and time.monotonic() - last_input >= idle_limit
                and not keep_awake() and screen_on()):
            log('idle %ds' % idle_limit)
            set_screen(False)
            last_input = time.monotonic()
        if pressed_at is not None and not long_fired and time.monotonic() - pressed_at >= LONG_PRESS_S:
            long_fired = True
            power_menu()
        for fd in ready:
            if fd in activity:
                for _ in events(fd):
                    pass
                continue
            for etype, code, value in events(fd):
                if etype != EV_KEY or value == 2:      # ignore autorepeat
                    continue
                if fd == tap:
                    if value == 1 and not screen_on():
                        log('double-tap key', code)
                        set_screen(True)
                    continue
                if code != KEY_POWER:
                    continue
                if value == 1:
                    pressed_at, long_fired = time.monotonic(), False
                elif pressed_at is not None:
                    if not long_fired:
                        set_screen(not screen_on())
                    pressed_at = None


if __name__ == '__main__':
    main()
